{
  "name": "nano-var-template",
  "version": "2.4.1",
  "description": "The smallest and most robust safe variable template engine for JavaScript",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit --strict --target es2020 --module commonjs test/types.ts",
    "typecheck:ts5": "npx -y -p typescript@5 tsc --noEmit --strict --target es2020 --module commonjs test/types.ts",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onexdata/nano-var-template.git"
  },
  "keywords": [
    "template",
    "engine",
    "variable",
    "interpolation",
    "placeholder",
    "injection",
    "vars",
    "variables",
    "functions",
    "plugins",
    "userland",
    "safe",
    "escaping",
    "async"
  ],
  "author": "Nick Steele <njsteele@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/onexdata/nano-var-template/issues"
  },
  "homepage": "https://github.com/onexdata/nano-var-template#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.2"
  }
}
